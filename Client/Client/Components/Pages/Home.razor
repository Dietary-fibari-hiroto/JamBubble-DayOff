@page "/"
@inject NavigationManager NavManager

<PageTitle>BrandScreen</PageTitle>

<div class="brand-screen">
    <img class="brand-icon @(IsHidden?"hidden":"")" src="images/icons/DayoffWhiteLogo.png" />
</div>

@code{
    private bool IsHidden = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsHidden = false;
            StateHasChanged();
            await Task.Delay(3000);
            IsHidden = true;
            StateHasChanged();
            await Task.Delay(1000);
            NavManager.NavigateTo("/auth/loadingscreen");
        }
    }
}