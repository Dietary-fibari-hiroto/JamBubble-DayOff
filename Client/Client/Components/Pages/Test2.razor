@page "/test2"
@using Client.Platforms.Android.Services
@inject ISpotifyService SpotifyService

<h3>Spotify Player</h3>

<div class="player-container">
    @if (!isConnected)
    {
        <button class="btn btn-primary" @onclick="Connect" disabled="@isConnecting">
            @(isConnecting ? "Connecting..." : "Connect to Spotify")
        </button>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    }
    else
    {
        <div class="player-controls">
            <div class="track-info mb-3">
                <h4>@currentTrack</h4>
                <p>@currentArtist</p>
            </div>
            
            <div class="progress-bar mb-3">
                <input type="range" 
                       class="form-range" 
                       min="0" 
                       max="@duration" 
                       value="@position" 
                       @oninput="OnSeek" />
                <div class="time-info">
                    <span>@FormatTime(position)</span>
                    <span>@FormatTime(duration)</span>
                </div>
            </div>
            
            <div class="control-buttons">
                <button class="btn btn-secondary" @onclick="SkipPrevious">
                    <span>⏮️</span>
                </button>
                
                @if (isPaused)
                {
                    <button class="btn btn-primary btn-lg" @onclick="Resume">
                        <span>▶️</span>
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-lg" @onclick="Pause">
                        <span>⏸️</span>
                    </button>
                }
                
                <button class="btn btn-secondary" @onclick="SkipNext">
                    <span>⏭️</span>
                </button>
            </div>
            
            <div class="mt-3">
                <input type="text" 
                       class="form-control mb-2" 
                       placeholder="Spotify URI (e.g., spotify:track:...)" 
                       @bind="spotifyUri" />
                <button class="btn btn-success" @onclick="PlayUri">Play URI</button>
            </div>
            
            <button class="btn btn-danger mt-3" @onclick="Disconnect">Disconnect</button>
        </div>
    }
</div>

@code {
    private bool isConnected = false;
    private bool isConnecting = false;
    private bool isPaused = true;
    private string currentTrack = "No track";
    private string currentArtist = "No artist";
    private long position = 0;
    private long duration = 0;
    private string errorMessage = "";
    private string spotifyUri = "";

    protected override void OnInitialized()
    {
        SpotifyService.ConnectionChanged += OnConnectionChanged;
        SpotifyService.PlayerStateChanged += OnPlayerStateChanged;
    }

    private async Task Connect()
    {
        isConnecting = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var success = await SpotifyService.ConnectAsync();
            if (!success)
            {
                errorMessage = "Failed to connect to Spotify";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private void Disconnect()
    {
        SpotifyService.Disconnect();
    }

    private void Pause()
    {
        SpotifyService.Pause();
    }

    private void Resume()
    {
        SpotifyService.Resume();
    }

    private void SkipNext()
    {
        SpotifyService.SkipNext();
    }

    private void SkipPrevious()
    {
        SpotifyService.SkipPrevious();
    }

    private void PlayUri()
    {
        if (!string.IsNullOrWhiteSpace(spotifyUri))
        {
            SpotifyService.Play(spotifyUri);
        }
    }

    private void OnSeek(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long newPosition))
        {
            SpotifyService.SeekTo(newPosition);
        }
    }

    private void OnConnectionChanged(object sender, SpotifyConnectionEventArgs e)
    {
        isConnected = e.IsConnected;
        if (!string.IsNullOrEmpty(e.ErrorMessage))
        {
            errorMessage = e.ErrorMessage;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnPlayerStateChanged(object sender, PlayerStateEventArgs e)
    {
        currentTrack = e.State.TrackName;
        currentArtist = e.State.ArtistName;
        isPaused = e.State.IsPaused;
        position = e.State.PositionMs;
        duration = e.State.DurationMs;
        InvokeAsync(StateHasChanged);
    }

    private string FormatTime(long milliseconds)
    {
        var seconds = milliseconds / 1000;
        var minutes = seconds / 60;
        seconds %= 60;
        return $"{minutes}:{seconds:D2}";
    }

    public void Dispose()
    {
        SpotifyService.ConnectionChanged -= OnConnectionChanged;
        SpotifyService.PlayerStateChanged -= OnPlayerStateChanged;
    }
}