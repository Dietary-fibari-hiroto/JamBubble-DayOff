@page "/app/session/create/confirm"
<ReturnButton/>
<section class="confirm-container space-y-20 margin-y-50">
        <figure class="img-container">
            <img class="icons" src="images/photos/offn.jpg" />
        </figure>
    <FormConfirmLabel LabelText="セッション名" Value="ナ" />
    <FormConfirmLabel LabelText="パスワード" Value="email" />
    <FormConfirmLabel LabelText="シーン設定" Value="password" />
    <FormConfirmLabel LabelText="ジャンル設定" Value="gender" />
    <FormConfirmLabel LabelText="ゲスト権限設定" Value="birthday" />
    <FormConfirmLabel LabelText="公開設定" Value="birthday" />
    <section class="provider-content">
        <p>プロバイダ</p>
        <img class="provider-icon" src="images/icons/spotify_icon.png" />
    </section>
    <Submit CssClass="spotify-primary" Label="セッションを始める"/>
</section>