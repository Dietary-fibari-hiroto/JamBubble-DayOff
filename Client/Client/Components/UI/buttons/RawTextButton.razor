<button @onclick="OnClick" class="flex-all-center ">
    <p class="string-ss @(IsUnderline ? "underline" : "")">@Label</p>
</button>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool IsUnderline { get; set; } = false;
    [Parameter] public EventCallback OnClick { get; set; }
}
