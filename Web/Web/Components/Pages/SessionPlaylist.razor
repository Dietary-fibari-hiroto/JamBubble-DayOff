@page "/sessionplaylist"

<div class="song-item-box">
    <!-- アイコン -->
    <img src="/images/photos/289964.jpg" alt="アイコン" class="song-icon" />

    <!-- テキスト群 -->
    <div class="song-details">
        <!-- 横並び：曲の題名 + アーティスト -->
        <div class="song-top">
            <span class="song-title">More than words</span>
            <span class="song-artist">羊文学</span>
        </div>

        <!-- 下段：送信者 -->
        <div class="song-sender">
            <span class="sender-label">送信者:</span>
            <span class="sender-name">ゆうと</span>
        </div>
    </div>
</div>

@code {
    // 後で曲情報リストをC#で管理する場合ここに書けます
}
