@page "/sessionmenber"

<div class="wrapper">
    <img class="close-btn" src="/images/elementIcons/x.svg" />
    <div class="list-container">
        <div class="member-container">
            <img class="image" src="/images/photos/659edf6203a148d523903f01beb20d21-300x300.png" alt="profile" />
            <div class="profile-infomation">
                <p class="string-md-bold" id="name">ゆづき</p>
                <p class="string-ss" id="stakeholders">ホスト</p>
            </div>
        </div>
        <div class="member-container">
            <img class="image" src="/images/elementIcons/circle-user-round.svg" alt="profile" />
            <div class="profile-infomation">
                <p class="string-md-bold" id="name">ゆうさく</p>
                <p class="string-ss" id="stakeholders">ゲスト</p>
            </div>
        </div>
        <div class="member-container">
            <img class="image" src="/images/elementIcons/circle-user-round.svg" alt="profile" />
            <div class="profile-infomation">
                <p class="string-md-bold" id="name">やまだ</p>
                <p class="string-ss" id="stakeholders">ゲスト</p>
            </div>
        </div>
        <div class="member-container">
            <img class="image" src="/images/photos/659edf6203a148d523903f01beb20d21-300x300.png" alt="profile" />
            <div class="profile-infomation">
                <p class="string-md-bold" id="name">加藤昌輝のパワーを味って見ましょう</p>
                <p class="string-ss" id="stakeholders">フレンド</p>
            </div>
        </div>

    </div>
</div>
<div class="menu-container">
    <div class="music-isplaying">
        <img  class="album" src="/images/photos/659edf6203a148d523903f01beb20d21-300x300.png" />
        <p class="string-ss" id="title">話題を長くすればどうなるのか</p>
    </div>
    <ul class="menu-bar">
        <li>
            <button>
                <img src="/images/elementIcons/qr-code.svg" alt="QR" />
            </button>
        </li>
        <li>
            <button>
                <img src="/images/elementIcons/git-pull-request-create-arrow.svg" alt="Request" />
            </button>
        </li>
        <li>
            <button>
                <img src="/images/elementIcons/list-minus.svg" alt="Playlist" />
            </button>
        </li>
    </ul>
</div>
