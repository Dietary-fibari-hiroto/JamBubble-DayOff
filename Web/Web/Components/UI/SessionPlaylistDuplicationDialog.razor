
<div class="center-wrapper">
    <div class="request-dialog">
        <p>この曲はキューに存在します。</p>
        <p>もう一度リクエストしますか？</p>

        <div class="button-group">
            <button class="action-btn request" @onclick="RequestAgain">
                <img src="/images/elementIcons/arrow-up-from-line.svg" class="btn-icon" />
                リクエスト
            </button>
            <button class="action-btn back" @onclick="GoBack">もどる</button>
        </div>


        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="message">@Message</p>
        }
    </div>
</div>

@code {
    private string Message { get; set; }

    private void RequestAgain()
    {
        Message = "リクエストを送信しました！";
    }

    private void GoBack()
    {
        Message = string.Empty;
    }
}
