@using Web.Components.UI.icons
<li class="music-label">
    <img class="music-pic" src="/images/elementIcons/eye.svg" />
    <div class="music-info">
        <p class="music-title">
            SongTitle 
        </p>
        <p class="music-artist">
            SongArtist
        </p>
    </div>
    <div class="arrow-icon">
        <ArrowRightIcon />
    </div>
</li>
@code {
    [Parameter] public string? SongTitle { get; set; } //値を渡すためのパラメータ
    [Parameter] public string? SongArtist { get; set; }
}
