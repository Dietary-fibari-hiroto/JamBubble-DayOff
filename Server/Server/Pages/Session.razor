@page "/session/{sessionId}"
@using Server.src.Signaling.Models
@using Server.src.Application.Services
@using Server.src.Signaling.Hubs
@using Microsoft.AspNetCore.SignalR.Client
@inject SessionManager SessionManager
@inject SpotifySearchService SpotifyService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Music Session - @SessionId</PageTitle>

<div class="container">

    @if (!_isJoined)
    {
        <EnterName GuestName="@_guestName"
                   GuestNameChanged="OnGuestNameChanged"
                   IsConnecting="@_isConnecting"
                   ErrorMessage="@_errorMessage"
        OnJoin="JoinSession" />
    }
    else
    {
        <!--
        <div class="user-info">
            <h2>Music Session: @SessionId</h2>
            <p>ようこそ、@_guestName さん！</p>
        </div>
        -->
        switch (_currentViewMode)
        {
            case ViewMode.Search:

            <TrackSearch SearchQuery="@_searchQuery"
                         SearchQueryChanged="(value) => _searchQuery = value"
                         IsSearching="@_isSearching"
                         SearchResults="@_searchResults"
                OnSearchInput="HandleSearchQueryChanged"
                OnTrackAdd="AddTrack"
                />
                break;
            case ViewMode.Playlist:
                <Playlist Items="@_playlist"
                      CurrentUserId="@_userId"
                      OnTrackRemove="RemoveTrack" />
                break;
        }

        <nav class="session-nav">
                <button class="session-nav__button" @onclick="()=>SwitchView(ViewMode.Search)">
                <img src="images/elements/list-minus.png" alt="qr_icon"/>

                </button>
                <button class="session-nav__button" @onclick="()=>SwitchView(ViewMode.Playlist)">
                <img src="images/elements/git-pull-request-arrow.png" alt="qr_icon" />
                </button>
            </nav>
    }


</div>


@code {
    public enum ViewMode
    {
        Search,
        Playlist
    }
    private ViewMode _currentViewMode = ViewMode.Search;
    [Parameter]
    public string SessionId { get; set; } = string.Empty;
    private System.Threading.Timer? _searchDebounceTimer;

    private HubConnection? _hubConnection;
    private string _guestName = string.Empty;
    private string _userId = string.Empty;
    private bool _isJoined = false;
    private bool _isConnecting = false;
    private string _errorMessage = string.Empty;

    private string _searchQuery = string.Empty;
    private bool _isSearching = false;
    private List<SpotifyTrackSearchResult> _searchResults = new();
    private List<PlaylistItem> _playlist = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeSignalR();
            StateHasChanged();
        }
    }

    private async Task InitializeSignalR()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/musicsessionhub"))
            .Build();

        _hubConnection.On<List<PlaylistItem>>("PlaylistUpdated", (playlist) =>
        {
            _playlist = playlist;
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On("SessionClosed", () =>
        {
            _errorMessage = "セッションが終了しました";
            _isJoined = false;
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }


    private void SwitchView(ViewMode viewMode)
    {
        _currentViewMode = viewMode;
    }

    private string IsActiveView(ViewMode viewMode)
    {
        return _currentViewMode == viewMode ? "active" : "";
    }

    private async Task JoinSession()
    {
        Console.WriteLine("=== JoinSession START ===");
        Console.WriteLine($"_guestName: '{_guestName}'");
        Console.WriteLine($"_hubConnection is null: {_hubConnection is null}");

        if (string.IsNullOrWhiteSpace(_guestName))
        {
            Console.WriteLine("GuestName is empty!");
            _errorMessage = "名前を入力してください";
            StateHasChanged();
            return;
        }

        _isConnecting = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        Console.WriteLine("Attempting to join...");

        try
        {
            var request = new JoinSessionRequest
            {
                SessionId = SessionId,
                GuestName = _guestName
            };

            Console.WriteLine($"Invoking JoinSession with SessionId: {SessionId}");
            var result = await _hubConnection!.InvokeAsync<bool>("JoinSession", request);
            Console.WriteLine($"Join result: {result}");

            if (result)
            {
                _userId = Guid.NewGuid().ToString();
                _isJoined = true;
                Console.WriteLine("Join successful!");
            }
            else
            {
                Console.WriteLine("Join failed - result was false");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex.Message}");
            _errorMessage = $"セッションへの参加に失敗しました: {ex.Message}";
        }
        finally
        {
            _isConnecting = false;
            StateHasChanged();
            Console.WriteLine("=== JoinSession END ===");
        }
    }

    private async Task SearchTracks(string query)
    {
        _isSearching = true;
        StateHasChanged();

        try
        {
            _searchResults = await SpotifyService.SearchTracksAsync(query);
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private async Task AddTrack(SpotifyTrackSearchResult track)
    {
        try
        {
            var request = new AddTrackRequest
            {
                SessionId = SessionId,
                SpotifyTrackId = track.Id,
                TrackName = track.Name,
                ArtistName = track.Artist,
                AlbumName = track.Album,
                AlbumImageUrl = track.AlbumImageUrl,
                DurationMs = track.DurationMs,
                RequestedBy = _guestName,
                RequestedByUserId = _userId
            };

            await _hubConnection!.InvokeAsync("AddTrack", request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"曲の追加に失敗しました: {ex.Message}";
        }
    }

    private async Task RemoveTrack(string itemId)
    {
        try
        {
            var request = new RemoveTrackRequest
            {
                SessionId = SessionId,
                ItemId = itemId,
                RequestedByUserId = _userId
            };

            await _hubConnection!.InvokeAsync("RemoveTrack", request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"曲の削除に失敗しました: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _searchDebounceTimer?.Dispose();

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }


    private async Task HandleSearchQueryChanged(string query)
    {
        // デバウンス処理（連続入力時に過剰なAPI呼び出しを防ぐ）
        _searchDebounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(query))
        {
            _searchResults.Clear();
            return;
        }

        _searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchTracks(query);
            });
        }, null, 500, Timeout.Infinite); // 500ms待ってから検索
    }

    private void OnGuestNameChanged(string value)
    {
        Console.WriteLine($"OnGuestNameChanged: '{value}'");
        _guestName = value;
        StateHasChanged();
    }
}
