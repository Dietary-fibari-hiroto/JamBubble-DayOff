@using Server.src.Signaling.Models

<section class="screen-frame member-list-screen">
    <button class="close-button" @onclick="OnReturn" type="button">
        <span class="close-icon">✕</span>
    </button>

    <div class="member-list-header">
        <h2 class="member-list-title">👥 参加メンバー</h2>
        <p class="member-count">@Members.Count 人が参加中</p>
    </div>

    @if (Members.Any())
    {
        <div class="members-container">
            <ul class="member-list">
                @foreach (var member in Members.OrderBy(m => m.JoinedAt))
                {
                    <li class="member-item">
                        <div class="member-avatar">
                            <span class="avatar-icon">🎵</span>
                        </div>
                        <div class="member-info">
                            <span class="member-name">@member.Name</span>
                            <span class="member-joined">
                                <span class="joined-icon">🕐</span>
                                @member.JoinedAt.ToLocalTime().ToString("HH:mm") に参加
                            </span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">👤</div>
            <p class="empty-text">まだメンバーがいません</p>
        </div>
    }
</section>

<style>
    .member-list-screen {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100dvh;
        color: white;
        overflow: hidden;
        box-sizing: border-box;
        position: relative;
    }

    .close-button {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

        .close-button:hover {
            background: rgba(255, 133, 0, 0.2);
            border-color: rgba(255, 133, 0, 0.4);
            transform: rotate(90deg) scale(1.1);
        }

        .close-button:active {
            transform: rotate(90deg) scale(0.95);
        }

    .close-icon {
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1;
    }

    .member-list-header {
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        margin-top: 60px;
    }

    .member-list-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 0.5rem 0;
        background: linear-gradient(135deg, #FF8500 0%, #FFB347 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .member-count {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
    }

    .members-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
    }

        .members-container::-webkit-scrollbar {
            width: 8px;
        }

        .members-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .members-container::-webkit-scrollbar-thumb {
            background: rgba(255, 133, 0, 0.3);
            border-radius: 4px;
        }

            .members-container::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 133, 0, 0.5);
            }

    .member-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .member-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
        transition: all 0.3s ease;
        animation: slideIn 0.3s ease-out;
    }

        .member-item:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 133, 0, 0.3);
            transform: translateX(4px);
        }

    .member-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255, 133, 0, 0.2) 0%, rgba(255, 179, 71, 0.2) 100%);
        border: 2px solid rgba(255, 133, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .avatar-icon {
        font-size: 1.5rem;
    }

    .member-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .member-name {
        font-weight: 700;
        font-size: 1.1rem;
        color: white;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .member-joined {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
    }

    .joined-icon {
        font-size: 0.8rem;
    }

    .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        text-align: center;
        animation: fadeIn 0.6s ease-out;
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 1.5rem;
        opacity: 0.3;
        animation: float 3s ease-in-out infinite;
    }

    .empty-text {
        font-size: 1.2rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
    }

    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateX(-20px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }

    }

    @@media (max-width: 480px) {
        .close-button

    {
        top: 1rem;
        right: 1rem;
        width: 40px;
        height: 40px;
    }

    .member-list-header {
        padding: 1rem;
        margin-top: 50px;
    }

    .member-list-title {
        font-size: 1.5rem;
    }

    .members-container {
        padding: 0.75rem;
    }

    .member-item {
        padding: 0.75rem;
    }

    .member-avatar {
        width: 45px;
        height: 45px;
    }

    .avatar-icon {
        font-size: 1.3rem;
    }

    .member-name {
        font-size: 1rem;
    }

    .member-joined {
        font-size: 0.8rem;
    }

    }
</style>

@code {
    [Parameter]
    public List<Guest> Members { get; set; } = new();

    [Parameter]
    public EventCallback Return { get; set; }

    private async Task OnReturn()
    {
        await Return.InvokeAsync();
    }
}
