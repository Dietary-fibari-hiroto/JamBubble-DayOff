@using Server.src.Signaling.Models

<section class="screen-frame playlist-screen">
    <div class="playlist-header">
        <h2 class="playlist-title">🎵 プレイリスト</h2>
        <p class="playlist-count">@Items.Count 曲</p>
    </div>

    @if (Items.Any())
    {
        <div class="playlist">
            @foreach (var item in Items.OrderBy(p => p.Order))
            {
                <div class="playlist-item">
                    <div class="item-content">
                        @if (!string.IsNullOrEmpty(item.AlbumImageUrl))
                        {
                            <div class="album-image-wrapper">
                                <img src="@item.AlbumImageUrl" alt="Album" class="album-image" />
                            </div>
                        }
                        <div class="track-info">
                            <div class="track-name">@item.TrackName</div>
                            <div class="track-artist">@item.ArtistName</div>
                            <div class="track-requester">
                                <span class="requester-icon">👤</span>
                                @item.RequestedBy
                            </div>
                        </div>
                    </div>
                    @if (item.RequestedByUserId == CurrentUserId)
                    {
                        <button class="remove-button"
                                @onclick="() => OnTrackRemove.InvokeAsync(item.Id)">
                            <span class="remove-icon">🗑️</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎼</div>
            <p class="empty-text">プレイリストは空です</p>
            <p class="empty-hint">曲を追加してセッションを盛り上げよう！</p>
        </div>
    }
</section>

<style>
    .playlist-screen {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100dvh;
        color: white;
        overflow: hidden;
        box-sizing: border-box;
    }

    .playlist-header {
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
    }

    .playlist-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 0.5rem 0;
        background: linear-gradient(135deg, #FF8500 0%, #FFB347 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .playlist-count {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
    }

    .playlist {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

        .playlist::-webkit-scrollbar {
            width: 8px;
        }

        .playlist::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .playlist::-webkit-scrollbar-thumb {
            background: rgba(255, 133, 0, 0.3);
            border-radius: 4px;
        }

            .playlist::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 133, 0, 0.5);
            }

    .playlist-item {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        transition: all 0.3s ease;
        animation: slideIn 0.3s ease-out;
    }

        .playlist-item:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 133, 0, 0.3);
            transform: translateX(4px);
        }

    .item-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
        min-width: 0;
    }

    .album-image-wrapper {
        flex-shrink: 0;
        position: relative;
    }

        .album-image-wrapper::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 8px;
            box-shadow: 0 4px 12px rgba(255, 133, 0, 0.2);
            pointer-events: none;
        }

    .album-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
    }

    .track-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .track-name {
        font-weight: 700;
        font-size: 1rem;
        color: white;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-artist {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-requester {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: rgba(255, 133, 0, 0.8);
        font-size: 0.8rem;
        margin-top: 0.25rem;
    }

    .requester-icon {
        font-size: 0.75rem;
    }

    .remove-button {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: rgba(220, 53, 69, 0.15);
        color: #ff6b6b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 1.2rem;
    }

        .remove-button:hover {
            background: rgba(220, 53, 69, 0.25);
            transform: scale(1.1);
        }

        .remove-button:active {
            transform: scale(0.95);
        }

    .remove-icon {
        display: block;
    }

    .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        text-align: center;
        animation: fadeIn 0.6s ease-out;
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 1.5rem;
        opacity: 0.3;
        animation: float 3s ease-in-out infinite;
    }

    .empty-text {
        font-size: 1.2rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.8);
        margin: 0 0 0.5rem 0;
    }

    .empty-hint {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@media (max-width: 480px) {
        .playlist-header {
            padding: 1rem;
        }

        .playlist-title {
            font-size: 1.5rem;
        }

        .playlist {
            padding: 0.75rem;
        }

        .playlist-item {
            padding: 0.75rem;
        }

        .album-image {
            width: 50px;
            height: 50px;
        }

        .track-name {
            font-size: 0.9rem;
        }

        .track-artist {
            font-size: 0.8rem;
        }

        .remove-button {
            width: 36px;
            height: 36px;
            font-size: 1rem;
        }
    }
</style>

@code {
    [Parameter]
    public List<PlaylistItem> Items { get; set; } = new();

    [Parameter]
    public string CurrentUserId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnTrackRemove { get; set; }
}
