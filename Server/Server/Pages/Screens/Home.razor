@using Server.src.Signaling.Models

<section class="screen-frame home-screen">
    <button class="close-button" @onclick="OnReturn" type="button">
        <img src="images/elements/contact.png"/>
    </button>

    <div class="home-content">
        <div class="session-icon">
            <span class="icon">🎵</span>
        </div>

        <div class="session-info">
            <div class="info-section">
                <label class="info-label">セッション名</label>
                <p class="info-value">@SessionName</p>
            </div>

            <div class="info-section">
                <label class="info-label">ホスト</label>
                <p class="info-value">@HostName</p>
            </div>

            <div class="info-section">
                <label class="info-label">シーン</label>
                <p class="info-value">@SceneName</p>
            </div>

            <div class="info-section">
                <label class="info-label">タグ</label>
                <div class="tags">
                    @foreach (var tag in Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            </div>
        </div>

        <button class="leave-button" @onclick="OnLeaveSession" type="button">
            <span class="leave-text">セッションを退出する</span>
        </button>
    </div>
</section>

<style>
    .home-screen {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100dvh;
        color: white;
        overflow: hidden;
        box-sizing: border-box;
        position: relative;
    }

    .close-button {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

        .close-button:hover {
            background: rgba(255, 133, 0, 0.2);
            border-color: rgba(255, 133, 0, 0.4);
            transform: rotate(90deg) scale(1.1);
        }

        .close-button:active {
            transform: rotate(90deg) scale(0.95);
        }

    .close-icon {
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1;
    }

    .home-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        gap: 2rem;
        overflow-y: auto;
    }

        .home-content::-webkit-scrollbar {
            width: 8px;
        }

        .home-content::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .home-content::-webkit-scrollbar-thumb {
            background: rgba(255, 133, 0, 0.3);
            border-radius: 4px;
        }

            .home-content::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 133, 0, 0.5);
            }

    .session-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255, 133, 0, 0.2) 0%, rgba(255, 179, 71, 0.2) 100%);
        border: 3px solid rgba(255, 133, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: float 3s ease-in-out infinite;
    }

    .icon {
        font-size: 3rem;
    }

    .session-info {
        width: 100%;
        max-width: 500px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .info-section {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.25rem;
        transition: all 0.3s ease;
    }

        .info-section:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 133, 0, 0.2);
        }

    .info-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: rgba(255, 133, 0, 0.9);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .info-value {
        font-size: 1.3rem;
        font-weight: 600;
        color: white;
        margin: 0;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        display: inline-block;
        background: rgba(255, 133, 0, 0.15);
        border: 1px solid rgba(255, 133, 0, 0.3);
        border-radius: 20px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #FFB347;
        transition: all 0.3s ease;
    }

        .tag:hover {
            background: rgba(255, 133, 0, 0.25);
            border-color: rgba(255, 133, 0, 0.5);
            transform: translateY(-2px);
        }

    .leave-button {
        width: 100%;
        max-width: 500px;
        height: 56px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 16px rgba(220, 53, 69, 0.3);
        margin-top: 1rem;
    }

        .leave-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
            background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
        }

        .leave-button:active {
            transform: translateY(0);
            box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);
        }

    .leave-icon {
        font-size: 1.3rem;
    }

    .leave-text {
        letter-spacing: 0.05em;
    }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }

    }

    @@media (max-width: 480px) {
        .close-button

    {
        top: 1rem;
        right: 1rem;
        width: 40px;
        height: 40px;
    }

    .home-content {
        padding: 1rem;
        gap: 1.5rem;
    }

    .session-icon {
        width: 80px;
        height: 80px;
    }

    .icon {
        font-size: 2.5rem;
    }

    .session-info {
        gap: 1rem;
    }

    .info-section {
        padding: 1rem;
    }

    .info-value {
        font-size: 1.1rem;
    }

    .leave-button {
        font-size: 1rem;
        height: 52px;
    }

    }
</style>

@code {
    [Parameter]
    public EventCallback Return { get; set; }

    [Parameter]
    public EventCallback OnLeave { get; set; }

    [Parameter]
    public string SessionName { get; set; } = "セッション名";

    [Parameter]
    public string HostName { get; set; } = "ホスト名";

    [Parameter]
    public string SceneName { get; set; } = "カフェでまったり";

    [Parameter]
    public List<string> Tags { get; set; } = new() { "ジャズ", "リラックス", "作業用" };

    private async Task OnReturn()
    {
        await Return.InvokeAsync();
    }

    private async Task OnLeaveSession()
    {
        await OnLeave.InvokeAsync();
    }
}
