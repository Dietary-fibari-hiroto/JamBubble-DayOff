@page "/"
@rendermode InteractiveServer

<PageTitle>JamBubble - 音楽セッション</PageTitle>

<div class="home-container">
    <div class="home-welcome">
        <div class="home-logo">
            <span class="logo-icon">🎵</span>
        </div>
        <h1 class="home-title">JamBubble</h1>
        <p class="home-subtitle">音楽セッションをみんなで楽しもう</p>
    </div>

    <div class="home-content">
        <p class="home-description">
            リアルタイムで音楽を共有・リクエストできる<br />
            コラボレーティブプレイリストアプリ
        </p>

        <div class="home-session-input">
            <label class="session-label">セッションIDを入力</label>
            <input class="session-input"
                   type="text"
                   @bind="_sessionId"
                   placeholder="例: abc123"
                   @onkeypress="HandleKeyPress" />
            <button class="join-button"
                    @onclick="JoinSession"
                    disabled="@string.IsNullOrWhiteSpace(_sessionId)">
                参加する
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message">
                <span class="error-icon">⚠️</span>
                <span>@_errorMessage</span>
            </div>
        }
    </div>

    <div class="home-footer">
        <p class="footer-note">ホストから共有されたセッションIDを入力してください</p>
    </div>
</div>

<style>
    .home-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        color: white;
        animation: fadeIn 0.6s ease-out;
    }

    .home-welcome {
        text-align: center;
        margin-bottom: 3rem;
        animation: slideDown 0.8s ease-out;
    }

    .home-logo .logo-icon {
        font-size: 5rem;
        display: inline-block;
        animation: bounce 2s ease-in-out infinite;
        filter: drop-shadow(0 4px 12px rgba(255, 133, 0, 0.4));
    }

    .home-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin: 1rem 0 0.5rem;
        background: linear-gradient(135deg, #FF8500 0%, #FFB347 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.05em;
    }

    .home-subtitle {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        font-weight: 300;
    }

    .home-content {
        width: 100%;
        max-width: 500px;
        animation: slideUp 0.8s ease-out 0.2s backwards;
    }

    .home-description {
        text-align: center;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 2.5rem;
        line-height: 1.6;
    }

    .home-session-input {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 2rem;
    }

    .session-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 0.05em;
    }

    .session-input {
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        font-size: 1.1rem;
        color: white;
        transition: all 0.3s ease;
        outline: none;
    }

        .session-input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .session-input:focus {
            border-color: #FF8500;
            background: rgba(255, 133, 0, 0.08);
            box-shadow: 0 0 0 4px rgba(255, 133, 0, 0.15);
            transform: translateY(-2px);
        }

    .join-button {
        background: linear-gradient(135deg, #FF8500 0%, #FF6B00 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1rem 2rem;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 16px rgba(255, 133, 0, 0.3);
    }

        .join-button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 133, 0, 0.4);
        }

        .join-button:active:not(:disabled) {
            transform: translateY(0);
        }

        .join-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background: rgba(255, 255, 255, 0.1);
            box-shadow: none;
        }

    .error-message {
        background: rgba(220, 53, 69, 0.15);
        border: 1px solid rgba(220, 53, 69, 0.4);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #ff6b6b;
        animation: shake 0.5s ease;
    }

    .error-icon {
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .home-footer {
        margin-top: 3rem;
        text-align: center;
        animation: fadeIn 1s ease-out 0.6s backwards;
    }

    .footer-note {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-8px);
        }

        75% {
            transform: translateX(8px);
        }
    }

    @@media (max-width: 480px) {
        .home-title {
            font-size: 2.5rem;
        }

        .home-logo .logo-icon {
            font-size: 4rem;
        }
    }
</style>

@code {
    private string _sessionId = "";
    private string _errorMessage = "";

    [Inject]
    private NavigationManager? NavigationManager { get; set; }

    private void JoinSession()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            _errorMessage = "セッションIDを入力してください";
            return;
        }

        // セッションページに遷移
        NavigationManager?.NavigateTo($"/session/{_sessionId.Trim()}");
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_sessionId))
        {
            JoinSession();
        }
    }
}
