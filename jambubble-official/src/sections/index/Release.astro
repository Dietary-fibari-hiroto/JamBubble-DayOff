---
import { SectionTitle } from "../../components";
import { ImagesIndex } from "../../assets/images/ImagesIndex";
---

<section class="release fill-bg__theme">
    <SectionTitle title="リリース" subTitle="Release" />
    <div class="release-download">
        <img class="release-download__img" src="data:image/png;base64,"/>
        <div>
            <p>
                JamBubble App (Android版) var 1.0.0
            </p>
            <p>Comming Soon...</p>
        </div>
    </div>
</section>

<style lang="scss">
    .release{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap:3rem;
        &-download{
            width:31.25rem;
            height:6.25rem;
            max-width:100%;
            color:white;
            background:#666666;
            box-sizing: border-box;
            padding:0 1rem;

            display: flex;
            justify-content: space-around;
            align-items: center;
            border-radius: 1rem;
            &__img{
                width: 4rem;
                height: 4rem;
            
            }
        }
    }
</style>